---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Music from '../components/Music.astro';
import Gigs from '../components/Gigs.astro';
import Contact from '../components/Contact.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<Hero />
		<About />
		<section class="music-gigs-row">
			<div class="container">
				<div class="two-col-grid">
					<Music />
					<Gigs />
				</div>
			</div>
		</section>
		<Contact />
	</main>
	
	<footer class="site-footer">
		<p>
			&copy; {new Date().getFullYear()} Nitro Sounds. All rights reserved.
			<span class="footer-separator">·</span>
			<button type="button" id="cookie-settings-btn" class="cookie-settings-btn">Configuració de galetes</button>
		</p>
	</footer>
</Layout>

<script is:inline>
	const cookieBtn = document.getElementById('cookie-settings-btn');
	if (cookieBtn) {
		cookieBtn.addEventListener('click', () => {
			window.dispatchEvent(new CustomEvent('open-cookie-banner'));
		});
	}
</script>

<style>
	.music-gigs-row {
		padding: 8rem 0;
	}

	.two-col-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	@media (max-width: 900px) {
		.two-col-grid {
			grid-template-columns: 1fr;
		}
	}

	.site-footer {
		text-align: center;
		padding: 2rem;
		background: rgba(0,0,0,0.5);
		color: rgba(255,255,255,0.4);
		font-size: 0.9rem;
	}

	.footer-separator {
		margin: 0 0.5rem;
		opacity: 0.5;
	}

	.cookie-settings-btn {
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.5);
		text-decoration: underline;
		font-family: inherit;
		font-size: inherit;
		cursor: pointer;
		padding: 0;
		transition: color 0.2s ease;
	}

	.cookie-settings-btn:hover {
		color: var(--color-primary);
	}
</style>
