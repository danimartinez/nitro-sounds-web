---
interface Gig {
  day: string;
  month: string;
  year?: string;
  title: string;
  location: string;
  isPast: boolean;
}

const gigs: Gig[] = [
  {
    day: "19",
    month: "SET",
    title: "La Pèrgola",
    location: "Vic",
    isPast: false,
  },
  {
    day: "13",
    month: "MAR",
    title: "Fidelity Club",
    location: "Sarava, Vic",
    isPast: true,
  },
  {
    day: "07",
    month: "MAR",
    title: "Snooz Parties",
    location: "Sarava, Vic",
    isPast: true,
  },
  {
    day: "26",
    month: "DES",
    year: "2025",
    title: "Snooz Parties",
    location: "Sarava, Vic",
    isPast: true,
  }
];
---

<section id="gigs" class="section-gigs">
  <div class="container">
    <h2 class="section-title">Upcoming Gigs</h2>

    <div class="gigs-list">
      {gigs.map((gig) => (
        <div class={`gig-item glass-panel ${gig.isPast ? 'past' : ''}`}>
          <div class="gig-date">
            <span class="day">{gig.day}</span>
            <span class="month">{gig.month}</span>
            {gig.year && <span class="year">{gig.year}</span>}
          </div>
          <div class="gig-details">
            <h3>{gig.title}</h3>
            <p class="location">{gig.location}</p>
          </div>
          {gig.isPast && (
            <div class="gig-action">
              <span class="badge-past">Past Event</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-gigs {
    padding: 0;
  }

  .gigs-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .gig-item {
    display: flex;
    align-items: center;
    padding: 1.5rem 2rem;
    transition: background 0.3s ease;
  }

  .gig-item:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .gig-item.past {
    opacity: 0.65;
  }

  .gig-item.past:hover {
    opacity: 0.95;
  }

  .badge-past {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .gig-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 2rem;
    min-width: 60px;
  }

  .day {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .month {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .year {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.5px;
  }

  .gig-details {
    flex: 1;
  }

  .gig-details h3 {
    margin-bottom: 0.2rem;
    font-size: 1.5rem;
  }

  .location {
    color: rgba(255, 255, 255, 0.6);
  }

  .btn-sm {
      padding: 0.5rem 1.5rem;
      font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .gig-item {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    
    .gig-date {
      margin-right: 0;
      flex-direction: row;
      gap: 0.5rem;
    }
  }
</style>
