---
// src/components/CookieBanner.astro
---

<div id="cookie-banner" class="cookie-banner hidden" role="dialog" aria-live="polite" aria-label="Gestió de cookies">
  <div class="cookie-content">
    <p class="cookie-text">
      Utilitzem galetes analítiques pròpies i de tercers per conèixer com interactues amb la web i millorar la teva experiència. Pots acceptar-les o rebutjar-les.
    </p>
    <div class="cookie-actions">
      <button id="cookie-reject" type="button" class="btn-cookie btn-reject">
        Rebutjar
      </button>
      <button id="cookie-accept" type="button" class="btn-cookie btn-accept">
        Acceptar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');

    if (!banner || !acceptBtn || !rejectBtn) return;

    let consent = null;
    try {
      consent = localStorage.getItem('nitro_consent');
    } catch (e) {}

    if (!consent) {
      banner.classList.remove('hidden');
      requestAnimationFrame(() => {
        banner.classList.add('visible');
      });
    }

    function setConsent(status) {
      try {
        localStorage.setItem('nitro_consent', status);
      } catch (e) {}

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          'analytics_storage': status
        });
      }

      banner.classList.remove('visible');
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 300);
    }

    acceptBtn.addEventListener('click', function() {
      setConsent('granted');
    });

    rejectBtn.addEventListener('click', function() {
      setConsent('denied');
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translate(-50%, 20px);
    width: calc(100% - 2rem);
    max-width: 520px;
    background: rgba(14, 14, 14, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 12px 36px -4px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .cookie-banner.visible {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .cookie-banner.hidden {
    display: none;
  }

  .cookie-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cookie-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .cookie-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .btn-cookie {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    font-family: var(--font-main);
  }

  .btn-reject {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-reject:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .btn-accept {
    background: var(--color-primary);
    color: white;
  }

  .btn-accept:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px -2px rgba(242, 121, 191, 0.4);
  }

  @media (max-width: 480px) {
    .cookie-actions {
      flex-direction: column-reverse;
      gap: 0.5rem;
    }

    .btn-cookie {
      width: 100%;
      text-align: center;
      padding: 0.7rem;
    }
  }
</style>
